# Copy this file to .env and fill in what you have.
# Everything is optional. The app runs fully without any of these.

# Port for the backend server (default 5000)
PORT=5000

# MongoDB connection string. If left empty, the app stores data
# in a local JSON file (server/data/db.json) instead. No setup needed.
MONGODB_URI=

# Google Gemini API key. If left empty, the savings plan is built with
# the built-in rule engine for Indian households (no AI call is made).
GEMINI_API_KEY=

# Gemini model to use when a key is present.
GEMINI_MODEL=gemini-2.0-flash
